# ============================================================
# ISAAC — Variables de entorno requeridas
# Copia este fichero como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.
# ============================================================

# Conexión a MongoDB Atlas (o local)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base_de_datos>?appName=<appName>

# Puerto del servidor Express
PORT=4000

# Secreto JWT — usa una cadena aleatoria larga (mínimo 32 caracteres)
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro_y_largo
