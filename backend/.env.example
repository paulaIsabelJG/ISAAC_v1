# ============================================================
# ISAAC — backend/.env.example
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Cadena de conexión de MongoDB Atlas.
# Formato: mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/NOMBRE_DB?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/isaac?retryWrites=true&w=majority

# ── Autenticación ────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# ── OpenAI ───────────────────────────────────────────────────
# API key de OpenAI para el corrector de frases IA.
OPENAI_API_KEY=sk-...

# Modelo de OpenAI a usar (por defecto: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# ── CORS / Frontend ──────────────────────────────────────────
# URL pública del frontend en Render. Sin barra final.
# Ejemplo: https://isaac-frontend.onrender.com
FRONTEND_URL=https://TU-FRONTEND.onrender.com

# ── Voice service (Python/FastAPI) ───────────────────────────
# URL del microservicio de voz personalizada.
# En desarrollo: http://localhost:8000
# En producción: URL del servicio en Render (si se despliega).
PYTHON_VOICE_URL=http://localhost:8000

# Desactivar la voz personalizada si no se despliega el voice_service.
# Poner a 'false' para deshabilitar el módulo de voz en producción.
VOICE_ENABLED=true

# Tiempo máximo de espera para la síntesis de voz (ms). Por defecto: 180000.
VOICE_TIMEOUT_MS=180000

# ── Puerto ───────────────────────────────────────────────────
# Render inyecta PORT automáticamente. No es necesario definirlo aquí.
# En desarrollo local, el backend arranca en el 4000 si PORT no está definido.
# PORT=4000
