# ============================================================
# ISAAC — backend/.gitignore
# Node.js / Express / Mongoose
# ============================================================

# ── Secretos ────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
log.txt

# ── Archivos temporales ──────────────────────────────────────
.tmp/
tmp/
*.tmp
*.tmp.*

# ── Build / dist ─────────────────────────────────────────────
dist/
out/

# ── Cobertura y tests ────────────────────────────────────────
coverage/
.nyc_output/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
._*

# ── IDEs ─────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.history/
