+    &:last-child { border-bottom: none; }
+    &:hover      { background: #fff8fb; }
+  }
+
+  tbody td {
+    padding:        14px;
+    vertical-align: middle;
+    text-align:     center;
+
+    &.us-perms-col-person { text-align: left; }
+  }
+
+  ion-checkbox {
+    --size:             18px;
+    --checkbox-background-checked: #{$pink-dark};
