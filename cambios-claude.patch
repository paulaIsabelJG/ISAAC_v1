+}
+
+.us-perms-table {
+  width:           100%;
+  border-collapse: collapse;
+  min-width:       860px;
+  font-size:       13px;
+
+  thead th {
+    padding:          11px 14px;
+    background:       $pink-light;
+    font-size:        11px;
+    font-weight:      700;
+    color:            $text-muted;
+    text-transform:   uppercase;
+    letter-spacing:   0.4px;
+    text-align:       center;
+    border-bottom:    1.5px solid $border;
+    white-space:      nowrap;
+
+    &.us-perms-col-person { text-align: left; min-width: 210px; }
+  }
+
+  tbody tr {
+    border-bottom: 1px solid lighten($border, 5%);
